# PDF2md Client Environment Variables Example
# Copy this file to .env and configure your values

# Server Configuration
PDF2MD_SERVER_URL=http://localhost:8000
PDF2MD_TIMEOUT=300
PDF2MD_CHUNK_SIZE=8192
PDF2MD_MAX_RETRIES=3
PDF2MD_VERIFY_SSL=true

# Output Configuration
PDF2MD_OUTPUT_DIR=
PDF2MD_OVERWRITE=false

# Logging
PDF2MD_VERBOSE=false

# Notes:
# - PDF2MD_SERVER_URL: URL of the PDF2md server (required)
# - PDF2MD_TIMEOUT: Request timeout in seconds (default: 300)
# - PDF2MD_CHUNK_SIZE: Upload chunk size in bytes (default: 8192)
# - PDF2MD_MAX_RETRIES: Maximum retry attempts for network errors (default: 3)
# - PDF2MD_VERIFY_SSL: Verify SSL certificates (default: true)
# - PDF2MD_OUTPUT_DIR: Default output directory for converted files (optional)
# - PDF2MD_OVERWRITE: Overwrite existing files without prompting (default: false)
# - PDF2MD_VERBOSE: Enable verbose logging (default: false)
